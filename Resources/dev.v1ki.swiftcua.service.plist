<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.v1ki.swiftcua.service</string>
    <key>ProgramArguments</key>
    <array>
        <string>__APP__/Contents/MacOS/CUAService</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/SwiftCUA/service.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/SwiftCUA/service.err.log</string>
</dict>
</plist>
